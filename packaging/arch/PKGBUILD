# Arch / EndeavourOS / Manjaro / CachyOS / Garuda
# Maintainer: rxvy
pkgname=ignifox-bin
pkgver=160.0.1
_emrel=1
pkgrel=1
pkgdesc="Telemetry-free, deeply customizable browser built on Firefox"
arch=('x86_64' 'aarch64')
url="https://github.com/rxvy-dev/ignifox"
license=('MPL-2.0')
depends=('gtk3' 'libxt' 'dbus-glib' 'alsa-lib' 'nss' 'ttf-font')
optdepends=('pulse-native-provider: audio'
            'ffmpeg: video playback'
            'libva-nvidia-driver: hardware video decoding on NVIDIA'
            'libva-mesa-driver: hardware video decoding on AMD/Intel')
provides=('ignifox')
conflicts=('ignifox')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver-$_emrel/ignifox-$pkgver-$_emrel-linux-x86_64.tar.xz")
source_aarch64=("$url/releases/download/v$pkgver-$_emrel/ignifox-$pkgver-$_emrel-linux-aarch64.tar.xz")
sha256sums_x86_64=('184aaf998ecb6c71d6b5a921c85c93e7ab453f59b43120d21e60089368fa00a7')
sha256sums_aarch64=('1c4c938f1d70700ac03ced211fb05c8d4bc0dae72afe692705758eb099de887c')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -a ignifox "$pkgdir/opt/ignifox"
  rm -f "$pkgdir/opt/ignifox/install.sh"
  ln -s /opt/ignifox/ignifox "$pkgdir/usr/bin/ignifox"
  sed 's|^Exec=ignifox|Exec=/usr/bin/ignifox|' ignifox/ignifox.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/ignifox.desktop"
  cp -r ignifox/icons "$pkgdir/usr/share/icons"
  install -Dm644 ignifox/LICENSE.ignifox "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
