# Template file for 'ignifox-bin'  (Void Linux / Auxo, glibc)
# Copy to void-packages/srcpkgs/ignifox-bin/template, then: ./xbps-src pkg ignifox-bin
pkgname=ignifox-bin
version=160.0
_emrel=2
revision=1
archs="x86_64 aarch64"
short_desc="Telemetry-free, deeply customizable browser built on Firefox"
maintainer="rxvy <rxvy@users.noreply.github.com>"
license="MPL-2.0"
homepage="https://github.com/rxvy-dev/ignifox"
depends="gtk+3 dbus-glib alsa-lib libXt nss"
nostrip=yes
noverifyrdeps=yes
distfiles="${homepage}/releases/download/v${version}-${_emrel}/ignifox-${version}-${_emrel}-linux-${XBPS_TARGET_MACHINE}.tar.xz"
case "$XBPS_TARGET_MACHINE" in
	x86_64) checksum=ce2003a1c9b35a54d849a6d36780d273a06cae5df56a7cacc14e3fd5224fbfd4 ;; # x86_64-sum
	aarch64) checksum=a40a2c1f0d7b62b3cacba5dc6da1a7219d7b2ce936ae72acc26c4fa30e2e9250 ;; # aarch64-sum
esac

do_install() {
	vmkdir opt/ignifox
	vcopy "*" opt/ignifox
	rm -f ${DESTDIR}/opt/ignifox/install.sh
	vmkdir usr/bin
	ln -s /opt/ignifox/ignifox ${DESTDIR}/usr/bin/ignifox
	sed 's|^Exec=ignifox|Exec=/usr/bin/ignifox|' ignifox.desktop > ignifox.desktop.sys
	vinstall ignifox.desktop.sys 644 usr/share/applications ignifox.desktop
	vmkdir usr/share
	cp -r icons ${DESTDIR}/usr/share/icons
	vlicense LICENSE.ignifox
}
